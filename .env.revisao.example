# Ambiente descartável de revisão (projeto zalek360-revisao). Copie para .env.revisao, que nunca é versionado.
# Gere os segredos sem exibi-los: infra/implantacao/preparar-segredos.ps1 -ArquivoEnv .env.revisao -ContainerBanco zalek360-revisao-db-1 -GerarChaveJwt -TrocarSenhaBanco
# (em volume novo, sem banco ainda, use -GerarChaveJwt -GerarSenhaBanco).
POSTGRES_DB=zalek360_revisao
POSTGRES_USER=zalek360_revisao
# Obrigatória, mínimo de 16 caracteres.
POSTGRES_PASSWORD=
POSTGRES_PORTA_HOST=55432
BACKEND_PORTA_HOST=5100
FRONTEND_PORTA_HOST=3100

# Obrigatória, mínimo de 32 caracteres.
JWT_CHAVE=

# A revisão usa os usuários de demonstração do AGENTS.md (somente em banco novo, vazio).
EXECUTAR_SEED=true
SENHA_USUARIOS_DEMO=
# O navegador aceita cookie Secure em http://localhost; mantenha true.
COOKIE_SEGURA=true

# Envio direto de proposta (opcional). Configure segredos somente no ambiente local.
# Sem Host/Remetente, usa o aplicativo de e-mail e PDF manual.
Email__Host=
Email__Porta=587
# StartTls (587), SslOnConnect (465); None somente para servidor de teste isolado.
Email__Seguranca=StartTls
Email__Usuario=
Email__Senha=
Email__Remetente=
Email__NomeRemetente=Zalek Personalizados
