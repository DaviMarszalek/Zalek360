# Backend Zalek360 — variáveis de ambiente (ASP.NET Core usa "__" como separador de seção).
# Em desenvolvimento local os valores de appsettings.Development.json já funcionam; use este arquivo como referência
# para Docker/servidor. NUNCA versione a chave real.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Banco PostgreSQL
ConnectionStrings__Zalek360=Host=localhost;Port=5432;Database=zalek360;Username=zalek360;Password=troque-esta-senha

# JWT — mínimo de 32 caracteres (a API não inicia com chave menor). Gere com: openssl rand -base64 48
Jwt__Chave=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres
Jwt__Emissor=Zalek360
Jwt__Audiencia=Zalek360.Web
Jwt__MinutosExpiracao=600
Jwt__DiasManterConectado=7

# Cookie de sessão httpOnly. Use true quando o sistema for servido via HTTPS.
Autenticacao__NomeCookie=zalek360_token
Autenticacao__CookieSegura=false

# Anexos (artes). No Docker a pasta é um volume persistente.
Armazenamento__Provedor=Local
Armazenamento__CaminhoLocal=/app/data/uploads

# Regras de data (validade, expiração automática, prazos em dias úteis)
Aplicacao__FusoHorario=America/Sao_Paulo

# Inicialização: migrations, verificação de esquema e dados de demonstração
Banco__AplicarMigrationsNaInicializacao=true
Banco__VerificarEsquema=true
Banco__ExecutarSeed=true
Banco__SenhaUsuariosDemo=Zalek@2026

# Rotinas em segundo plano
Rotinas__ExpiracaoHabilitada=true
Rotinas__ExpiracaoIntervaloMinutos=60
Rotinas__LimpezaAnexosHabilitada=true

# Swagger em http://localhost:5000/swagger (desative em produção se desejar)
Swagger__Habilitado=true
Https__Redirecionar=false
# CORS só é necessário se o navegador chamar a API diretamente (o frontend usa proxy /api no mesmo domínio).
# Cors__Origens__0=http://localhost:3000
