# Copie para .env (mesma pasta do docker-compose.yml). O .env nunca é versionado.
# Para criar os segredos sem exibi-los, use: infra/implantacao/preparar-segredos.ps1 (veja docs/11-atualizar-ambiente-principal.md).

# Banco. POSTGRES_PASSWORD é obrigatória (mínimo de 16 caracteres; a API recusa senha curta ou publicada).
# Em um volume já existente, mudar POSTGRES_PASSWORD aqui NÃO muda a senha do banco: siga o docs/11 (ALTER ROLE).
POSTGRES_DB=zalek360
POSTGRES_USER=zalek360
POSTGRES_PASSWORD=

# Chave de assinatura do JWT — obrigatória, mínimo de 32 caracteres e nunca um valor publicado no repositório.
JWT_CHAVE=

# Cookie de sessão com Secure (padrão true): o login só se mantém em HTTPS ou em http://localhost.
# Use false somente de forma consciente, para acesso por http://IP na rede local sem HTTPS.
COOKIE_SEGURA=true

# Dados e usuários de demonstração em banco vazio. Nunca ligue em banco com dados reais.
# Quando true, SENHA_USUARIOS_DEMO é obrigatória.
EXECUTAR_SEED=false
SENHA_USUARIOS_DEMO=

# Portas publicadas. O frontend fica acessível na rede; API e PostgreSQL só neste computador (127.0.0.1).
FRONTEND_PORTA_HOST=3000
BACKEND_PORTA_HOST=5000
POSTGRES_PORTA_HOST=5432

# Dados públicos exibidos na Proposta Comercial (vazios são omitidos).
Empresa__NomeFantasia=Zalek Personalizados
Empresa__RazaoSocial=
Empresa__Cnpj=
Empresa__Telefone=
Empresa__WhatsApp=
Empresa__Email=
Empresa__Site=
Empresa__Endereco=
# Opcional: arquivo PNG/JPG legível no contêiner, ex. /app/data/empresa/logo.png.
Empresa__CaminhoLogo=
Empresa__TextoRodape=

# Envio direto de proposta (opcional). Configure segredos somente no ambiente local.
# Sem Host/Remetente, usa o aplicativo de e-mail e PDF manual.
Email__Host=
Email__Porta=587
# StartTls (587), SslOnConnect (465); None somente para servidor de teste isolado.
Email__Seguranca=StartTls
Email__Usuario=
Email__Senha=
Email__Remetente=
Email__NomeRemetente=Zalek Personalizados
