# Copie para .env (mesma pasta do docker-compose.yml) para sobrescrever os padrões de demonstração.

# Banco
POSTGRES_DB=zalek360
POSTGRES_USER=zalek360
POSTGRES_PASSWORD=troque-esta-senha

# Chave de assinatura do JWT — mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_CHAVE=troque-por-uma-chave-aleatoria-com-pelo-menos-32-caracteres

# true somente quando o sistema estiver atrás de HTTPS (ex.: infra/nginx)
COOKIE_SEGURA=false

# Dados de demonstração (clientes, orçamentos e pedidos do protótipo) e senha dos usuários demo
EXECUTAR_SEED=true
SENHA_USUARIOS_DEMO=Zalek@2026

SWAGGER_HABILITADO=true

# Portas publicadas no computador (altere se já estiverem em uso)
FRONTEND_PORTA_HOST=3000
BACKEND_PORTA_HOST=5000
POSTGRES_PORTA_HOST=5432
